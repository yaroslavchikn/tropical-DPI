<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <!-- Задний градиентный фон -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_gradient"
        android:alpha="0.3"/>

    <!-- Основная карточка -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/main_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/card_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp"
                android:gravity="center_horizontal">

                <!-- Заголовок с иконкой -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚀"
                        android:textSize="48sp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YouTube Turbo"
                        android:textSize="32sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"/>
                </LinearLayout>

                <!-- Подзаголовок -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Обход DPI без VPN"
                    android:textSize="16sp"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="24dp"/>

                <!-- Статус -->
                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏸ ОБХОД ОТКЛЮЧЁН"
                    android:textSize="20sp"
                    android:textColor="@color/gray"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- Индикатор загрузки -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_indicator"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/teal"
                    app:indicatorSize="48dp"
                    app:trackThickness="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Переключатель -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/toggle_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/teal"
                    android:trackTint="@color/gray"
                    android:text="Активировать обход"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:padding="12dp"
                    android:gravity="center"
                    android:layout_marginBottom="24dp"/>

                <!-- Карточка статистики -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/stats_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:translationY="100dp"
                    android:alpha="0f"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/dark_bg"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/traffic_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📊 Трафик: 0 B"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:padding="4dp"/>

                        <TextView
                            android:id="@+id/uptime_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⏱ Время работы: 0с"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:padding="4dp"/>

                        <TextView
                            android:id="@+id/speed_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚡ Скорость: 0 B/s"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:padding="4dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
